FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for video processing and image operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy MCP and helper modules
COPY mcp/ ./mcp/
COPY agents/ ./agents/

# Create directory for audit logs
RUN mkdir -p /app/mcp && chmod 777 /app/mcp

EXPOSE 8001

CMD ["python3", "-m", "uvicorn", "mcp.server:app", "--host", "0.0.0.0", "--port", "8001"]
